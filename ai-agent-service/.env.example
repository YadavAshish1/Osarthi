# Osarthi AI Agent Service — Environment Variables

# ─── LLM Provider Keys ───────────────────────────────────────────────
# Azure OpenAI (DEFAULT provider)
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Google Gemini (optional, enable from portal)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI Direct (optional, enable from portal)
OPENAI_API_KEY=your-openai-api-key

# Default LLM provider: azure_openai | gemini | openai
DEFAULT_LLM_PROVIDER=azure_openai

# ─── MongoDB ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/osarthi

# ─── JWT (same secret as Node.js backend for token verification) ─────
JWT_ACCESS_SECRET=your-jwt-access-secret

# ─── Azure Cloud Ops (Super Admin tools) ─────────────────────────────
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
# Uses DefaultAzureCredential in production (Managed Identity)
# For local dev, set these or use `az login`:
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# ─── Service Config ──────────────────────────────────────────────────
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001
NODE_BACKEND_URL=http://localhost:5000
